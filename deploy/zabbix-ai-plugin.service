[Unit]
Description=Zabbix AI Dialog Plugin (FastAPI)
After=network.target mysql.service

[Service]
Type=simple
User=zabbix
WorkingDirectory=/opt/zabbix-ai-plugin
EnvironmentFile=/opt/zabbix-ai-plugin/.env
ExecStart=/opt/zabbix-ai-plugin/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 10801
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
