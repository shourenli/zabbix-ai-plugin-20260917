# 本机/部署环境变量【模板】
# ⚠ 本文件会被提交到仓库（.gitignore 只忽略 .env），因此**这里只能留空或写占位符**。
# 真实值放到同目录的 .env 里 —— .env 已被 .gitignore 忽略，不会进 git。
LLM_API_KEY=

# MySQL 密码（部署时填写，需与 deploy/schema.sql 中创建的账号一致）
MYSQL_PASSWORD=

# 仅 config.yaml 中 auth.mode=service 时需要
ZABBIX_SERVICE_USER=
ZABBIX_SERVICE_PASSWORD=

# 钉钉群机器人 access_token（填好后 config.yaml 里的 ${VAR} 才会生效）
DINGTALK_NETWORK_A=
DINGTALK_IDC_B=

# 钉钉加签密钥（仅当机器人安全设置选"加签"时填；
# 并把 config.yaml 里对应供应商的 secret_env 指向这些变量名）
DINGTALK_NETWORK_A_SECRET=
DINGTALK_IDC_B_SECRET=
